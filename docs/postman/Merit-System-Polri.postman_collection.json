{
  "info": {
    "_postman_id": "b22364c2-cdb8-4aba-9a2e-91375d3d759c",
    "name": "Merit System Personel Polri API",
    "description": "Collection endpoint utama Merit System. Jalankan Login lebih dahulu; token disimpan otomatis ke environment.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Dashboard & Monitoring",
      "item": [
        { "name": "Dashboard sesuai role dan scope", "request": { "method": "GET", "url": "{{base_url}}/dashboard" } },
        { "name": "Monitoring khusus System Admin", "request": { "method": "GET", "url": "{{base_url}}/system-status" } }
      ]
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Login",
          "auth": { "type": "noauth" },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('Login berhasil', () => pm.response.to.have.status(200));",
                "const body = pm.response.json();",
                "if (body.data?.token) pm.environment.set('token', body.data.token);"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"device_name\": \"postman\"\n}"
            },
            "url": "{{base_url}}/auth/login"
          }
        },
        { "name": "Profil Saya", "request": { "method": "GET", "url": "{{base_url}}/auth/me" } },
        { "name": "Logout", "request": { "method": "POST", "url": "{{base_url}}/auth/logout" } }
      ]
    },
    {
      "name": "Pengguna & Scope",
      "item": [
        {
          "name": "Daftar Pengguna",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/users?status=active&sort=name&direction=asc&per_page=10"
          }
        },
        { "name": "Detail Pengguna", "request": { "method": "GET", "url": "{{base_url}}/users/{{user_id}}" } },
        {
          "name": "Tambah Operator dengan Scope",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"personel_id\": {{personel_id}},\n  \"email\": \"operator.demo@example.test\",\n  \"password\": \"Password123!\",\n  \"password_confirmation\": \"Password123!\",\n  \"role\": \"operator\",\n  \"is_active\": true,\n  \"scopes\": [\n    {\n      \"unit_organisasi_id\": {{unit_id}},\n      \"scope_type\": \"unit_and_descendants\",\n      \"is_active\": true,\n      \"berlaku_mulai\": \"2026-01-01\",\n      \"berlaku_sampai\": null\n    }\n  ]\n}"
            },
            "url": "{{base_url}}/users"
          }
        },
        {
          "name": "Ubah Pengguna dan Scope",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"personel_id\": {{personel_id}},\n  \"email\": \"operator.demo@example.test\",\n  \"password\": \"\",\n  \"password_confirmation\": \"\",\n  \"role\": \"operator\",\n  \"is_active\": true,\n  \"scopes\": [\n    {\n      \"unit_organisasi_id\": {{unit_id}},\n      \"scope_type\": \"own_unit\",\n      \"is_active\": true,\n      \"berlaku_mulai\": null,\n      \"berlaku_sampai\": null\n    }\n  ]\n}"
            },
            "url": "{{base_url}}/users/{{user_id}}"
          }
        },
        { "name": "Nonaktifkan dan Cabut Token", "request": { "method": "DELETE", "url": "{{base_url}}/users/{{user_id}}" } }
      ]
    },
    {
      "name": "Personel",
      "item": [
        {
          "name": "Daftar + Filter Merit",
          "description": "Sorting server sebelum pagination: nama, jabatan (utama aktif), satker, pangkat, jumlah_kualifikasi, durasi_pengalaman, jumlah_operasi, durasi_operasi, kualifikasi_terbaru, terbaru. Direction asc/desc. Filter dan scope tetap berlaku; UI header kembali ke halaman pertama ketika urutan berubah.",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/personel?search=&bidang_fungsi_id={{bidang_fungsi_id}}&sort=durasi_pengalaman&direction=desc&per_page=10",
              "host": ["{{base_url}}"],
              "path": ["personel"],
              "query": [
                { "key": "search", "value": "", "disabled": true },
                { "key": "bidang_fungsi_id", "value": "{{bidang_fungsi_id}}", "disabled": true },
                { "key": "sort", "value": "durasi_pengalaman" },
                { "key": "direction", "value": "desc" },
                { "key": "per_page", "value": "10" }
              ]
            }
          }
        },
        { "name": "Detail", "request": { "method": "GET", "url": "{{base_url}}/personel/{{personel_id}}" } },
        {
          "name": "Tambah",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jenis_personel\": \"polri\",\n  \"nomor_identitas\": \"99001122\",\n  \"nama_lengkap\": \"Personel Demo Postman\",\n  \"pangkat_id\": {{pangkat_id}},\n  \"tempat_lahir\": \"Bengkulu\",\n  \"tanggal_lahir\": \"1990-01-01\",\n  \"unit_organisasi_id\": {{unit_id}},\n  \"status\": \"aktif\",\n  \"pendidikan_umum\": {\"nama_kualifikasi\": \"SMA Demo\", \"tahun\": 2008},\n  \"pendidikan_polri\": {\"nama_kualifikasi\": \"SPN Demo\", \"tahun\": 2009},\n  \"jabatan_utama\": {\n    \"nama_jabatan\": \"Banit Sat Intelkam\",\n    \"bidang_fungsi_id\": {{bidang_fungsi_id}},\n    \"jenis_penugasan_id\": {{jenis_penugasan_id}},\n    \"tanggal_mulai\": \"2026-01-01\"\n  }\n}"
            },
            "url": "{{base_url}}/personel"
          }
        },
        {
          "name": "Ubah Identitas",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"nama_lengkap\": \"Nama Personel Diperbarui\"\n}" },
            "url": "{{base_url}}/personel/{{personel_id}}"
          }
        },
        { "name": "Arsipkan dengan alasan (Admin)", "request": { "method": "DELETE", "header": [{"key":"Content-Type","value":"application/json"}], "body": {"mode":"raw","raw":"{\"alasan_arsip\":\"Duplikat pencatatan demo\"}"}, "url": "{{base_url}}/personel/{{personel_id}}" } },
        { "name": "Daftar Arsip (Admin)", "request": { "method": "GET", "url": "{{base_url}}/personel?arsip=1&per_page=10" } },
        { "name": "Pulihkan Arsip (Admin)", "request": { "method": "POST", "url": "{{base_url}}/personel/{{personel_id}}/restore" } },
        { "name": "Cari Pemilik Akun (Admin)", "request": { "method": "GET", "url": "{{base_url}}/personel-options?search=Agus" } }
      ]
    },
    {
      "name": "Kualifikasi",
      "item": [
        { "name": "Detail untuk Form Edit", "request": { "method": "GET", "url": "{{base_url}}/kualifikasi/{{kualifikasi_id}}" } },
        { "name": "Daftar", "request": { "method": "GET", "url": "{{base_url}}/personel/{{personel_id}}/kualifikasi" } },
        {
          "name": "Tambah dengan PDF Opsional",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "jenis_kualifikasi_id", "value": "{{jenis_kualifikasi_id}}", "type": "text" },
                { "key": "bidang_fungsi_id", "value": "{{bidang_fungsi_id}}", "type": "text" },
                { "key": "nama_kualifikasi", "value": "Pelatihan Analisis Intelijen", "type": "text" },
                { "key": "tahun", "value": "2026", "type": "text" },
                { "key": "dokumen_pendukung", "type": "file", "src": [], "disabled": true }
              ]
            },
            "url": "{{base_url}}/personel/{{personel_id}}/kualifikasi"
          }
        },
        {
          "name": "Ubah",
          "request": {
            "method": "PUT",
            "body": { "mode": "raw", "raw": "{\"nama_kualifikasi\":\"Pelatihan Analisis Intelijen Lanjutan\"}" },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/kualifikasi/{{kualifikasi_id}}"
          }
        },
        { "name": "Download PDF", "request": { "method": "GET", "url": "{{base_url}}/kualifikasi/{{kualifikasi_id}}/dokumen" } },
        { "name": "Ganti PDF melalui Method Override", "request": { "method": "POST", "body": { "mode": "formdata", "formdata": [{ "key": "_method", "value": "PUT", "type": "text" }, { "key": "dokumen_pendukung", "type": "file", "src": [], "disabled": true }] }, "url": "{{base_url}}/kualifikasi/{{kualifikasi_id}}" } },
        { "name": "Lepas PDF", "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"hapus_dokumen\":true}" }, "url": "{{base_url}}/kualifikasi/{{kualifikasi_id}}" } },
        { "name": "Soft Delete", "request": { "method": "DELETE", "url": "{{base_url}}/kualifikasi/{{kualifikasi_id}}" } }
      ]
    },
    {
      "name": "Riwayat Jabatan dan Mutasi",
      "item": [
        { "name": "Detail Riwayat untuk Form Edit", "request": { "method": "GET", "url": "{{base_url}}/riwayat-jabatan/{{riwayat_jabatan_id}}" } },
