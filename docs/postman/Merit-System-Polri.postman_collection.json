            "url": "{{base_url}}/personel/{{personel_id}}/ganti-jabatan"
          }
        },
        {
          "name": "Mutasi Lintas Unit",
          "request": {
            "method": "POST",
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "unit_organisasi_id", "value": "{{unit_tujuan_id}}", "type": "text" },
                { "key": "nama_jabatan", "value": "Kanit Intelkam", "type": "text" },
                { "key": "bidang_fungsi_id", "value": "{{bidang_fungsi_id}}", "type": "text" },
                { "key": "jenis_penugasan_id", "value": "{{jenis_penugasan_id}}", "type": "text" },
                { "key": "tanggal_mulai", "value": "2026-10-01", "type": "text" }
              ]
            },
            "url": "{{base_url}}/personel/{{personel_id}}/mutasi"
          }
        },
        { "name": "Download SK", "request": { "method": "GET", "url": "{{base_url}}/riwayat-jabatan/{{riwayat_jabatan_id}}/dokumen" } },
        { "name": "Hapus Riwayat Selesai", "request": { "method": "DELETE", "url": "{{base_url}}/riwayat-jabatan/{{riwayat_jabatan_id}}" } }
      ]
    },
