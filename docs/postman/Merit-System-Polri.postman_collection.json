        { "name": "Lepas SK PDF", "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"hapus_dokumen\":true}" }, "url": "{{base_url}}/riwayat-jabatan/{{riwayat_jabatan_id}}" } },
        { "name": "Daftar Riwayat", "request": { "method": "GET", "url": "{{base_url}}/personel/{{personel_id}}/riwayat-jabatan" } },
